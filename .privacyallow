# Regexes for known-safe matches. Any flagged line matching one of these is dropped.
# Keep this list short and specific — each entry is a hole in the gate.

# PRIVACY.md / CLAUDE.md document the version rule using deliberately fake versions.
9\.9\.9
React 9\.9
SomeFramework
SomeDb 42\.0
SomeLang 7\.1
somedb:42\.0

# PRIVACY.md's enforcement section quotes the version-pin regex itself.
grep -rEn

# Test fixture timestamp, not an account id.
touch -t [0-9]{12}

# The CI template needs a real checkout pin (PRIVACY.md exception).
actions/checkout@v4

# run-implementer test names its profile id and model id.
"grok model".*grok-4\.5

# run-implementer profile table: model id and low-effort profile aliases.
^[[:space:]]*MODEL=grok-4\.5$
^[[:space:]]*grok-low\|grok-4\.5-low\|grok-4\.5-low-effort\|grok45-low\)$
